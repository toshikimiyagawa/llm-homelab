{{ ansible_managed | comment }}
[Unit]
Description=Cloudflare Tunnel (cloudflared) — issue #88
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config {{ cloudflared_config_path }} tunnel run
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
